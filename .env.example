# ── PostgreSQL (db service) ────────────────────────────────────────
POSTGRES_DB=ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats

# ── Spring Boot backend ────────────────────────────────────────────
SERVER_PORT=8000
# Compose service is named `db` — keep the host in sync with docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ats
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# AI mode: stub (dev default) | omniroute (delegates to the gateway)
ATS_DOCTOR_AI_MODE=stub

# AI facade retry/backoff budget (FEAT-005, TASK-016)
ATS_DOCTOR_AI_TIMEOUT_SECONDS=30
ATS_DOCTOR_AI_RETRY_MAX_ATTEMPTS=3
ATS_DOCTOR_AI_BACKOFF_BASE_MS=200
# dev/test degrade to a labeled stub result on total failure
ATS_DOCTOR_AI_DEGRADE_TO_STUB=true

# Persistence: true (default in the compose stack since SPRINT-01) wires
# Postgres + Flyway + JPA (resume pipeline + ai_runs tracking);
# false boots the app without a database (unit-test mode, TASK-006).
ATS_DOCTOR_PERSISTENCE_ENABLED=true

# File storage roots. Container runs (docker compose) use the /data paths
# under the mounted ./data volume so artifacts persist on the host;
# local `mvn spring-boot:run` falls back to application.yml defaults (data/...).
ATS_DOCTOR_RESUME_DIR=/data/resumes
ATS_DOCTOR_JOBS_DIR=/data/jobs
ATS_DOCTOR_EXPORTS_DIR=/data/exports

# Single fallback per profile (PRD §6.4), e.g. quality -> local
PROFILE_QUALITY_FALLBACK=local

# ── AI gateway (Spring AI -> OmniRoute, deployment-only, PRD §6.3) ─
# OmniRoute forwards to the configured provider (DeepSeek default).
#
# Local development can exercise the omniroute path without a real gateway:
#   python3 omniroute/dev-gateway/mock_gateway.py 8080
# then set ATS_DOCTOR_AI_MODE=omniroute and BASE_URL below to localhost.
SPRING_AI_OPENAI_BASE_URL=http://omniroute:8080
# Placeholder in dev — real keys live in deployment config only.
SPRING_AI_OPENAI_API_KEY=placeholder
# Default model configuration — never referenced in application code.
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-v4-flash

# ── Next.js frontend ───────────────────────────────────────────────
# OrbStack uses 3000 for its dashboard, so the frontend runs on 3002.
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
